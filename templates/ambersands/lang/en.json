// ambersands — en. Keys: modules/rts/RtsLocalize.h; how-to keys: engine/ui docs.
{
  "@language": "English",

  // how to play (UI: "How to play" screen)
  "howto.like": "Dune II: three Houses, spice in the sands, harvesters, windtraps and sandworms.",
  "howto.goal": "Destroy every enemy building.",
  "howto.tip": "Never leave a harvester alone on open sand: a worm swallows vehicles whole.",
  "howto.step1": "Deploy the MCV into a construction yard. Structures are built in the yard and placed next to the base, on rock only. Lay concrete slabs first: a building without concrete starts half-ruined and weathers away.",
  "howto.step2": "A refinery comes with a harvester. Credits are capped by the yard, refineries and silos — the rest is lost.",
  "howto.step3": "Spice does not grow back: new spice comes from blooms — drive over one and it bursts into a fresh field.",
  "howto.step4": "Vehicles crush infantry. Every House has its own units: sonic tank, devastator, deviator; the palace gives the Death Hand, Fremen or a saboteur."
}
