// Game manifest: read by the client at startup and by rtsbuild when packaging.
{
  "description": "Классика Warcraft/RA: база, армия, башни.",
  "name": "Iron and Gold",
  "id": "com.rtsengine.ironandgold",
  "version": "0.1.0",
  "build": 1,
  "module": "rts",
  "sourceLanguage": "en",
  "languages": ["en", "ru"],
  "rules": "rules.json",
  "maps": [
    { "file": "maps/valley.json", "title": "River Valley (1v1)" }
  ],
  "lighting": { "time": 0.35, "dayLength": 480, "clouds": 0.55 },
  "orientation": "landscape",
  "icons": {
    "default": "branding/icon.png",
    "background": "#101a28",
    "android": { "foreground": "branding/icon_foreground.png", "foregroundPadding": 0.2, "background": "#101a28",
                 "monochrome": "branding/icon_monochrome.png" }
  },
  "splash": {
    "background": "#0a0f16",
    "image": "branding/splash_bg.png", "fit": "cover",
    "logos": [
      { "image": "branding/studio.png", "start": 0, "duration": 2.2, "scale": 0.34,
        "animation": { "fadeIn": 0.5, "fadeOut": 0.45, "zoom": { "from": 0.85, "duration": 0.8 } } },
      { "image": "branding/logo_socket.png", "start": 2.0, "scale": 0.55, "anchor": [0.5, 0.46],
        "animation": [ { "t": 0, "opacity": 0, "scale": 0.7 }, { "t": 0.6, "opacity": 1, "scale": 1.0, "ease": "out" },
                       { "t": 1.4, "scale": 1.03, "ease": "inOut" }, { "t": 2.2, "scale": 1.0, "ease": "inOut" } ] },
      { "sheet": "branding/coin_sheet.png", "frame": [128, 128], "count": 8, "fps": 14, "start": 2.0,
        "scale": 0.2, "anchor": [0.5, 0.444],
        "animation": [ { "t": 0, "opacity": 0, "scale": 0.7 }, { "t": 0.6, "opacity": 1, "scale": 1.0, "ease": "out" },
                       { "t": 1.4, "scale": 1.03, "ease": "inOut" }, { "t": 2.2, "scale": 1.0, "ease": "inOut" } ] }
    ],
    "minSeconds": 3.5, "maxSeconds": 6, "skippable": true, "fadeOut": 0.5,
    "progress": { "color": "#e8b640", "track": "#ffffff26", "position": "bottom", "width": 0.36, "height": 5 },
    "native": { "image": "branding/logo.png", "scale": 0.35 }
  }
}
