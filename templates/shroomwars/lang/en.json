{
  "@language": "English",

  // how to play (UI: "How to play" screen)
  "howto.like": "Mushroom Wars 2: villages, towers and forges, morale and heroes.",
  "howto.goal": "Take every enemy building.",
  "howto.tip": "More than four forges is pointless — the fifth adds nothing.",
  "howto.step1": "Villages grow mushrooms; an upgrade (up to level 4) is paid with the mushrooms inside: more room, faster growth, better defence.",
