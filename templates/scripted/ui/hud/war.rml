<rml>
<head>
    <title>war</title>
    <link type="text/rcss" href="../theme.rcss"/>
    <link type="text/rcss" href="../skin.rcss"/>
    <style>
        body { width: 100%; height: 100%; pointer-events: none; }
        #war { position: absolute; left: 12dp; top: 64dp; width: 210dp; padding: 8dp 10dp; pointer-events: auto; }
        #war .row { display: flex; justify-content: space-between; margin: 2dp 0; }
        #war .title { font-weight: bold; margin-bottom: 4dp; }
        #war button { width: 100%; margin-top: 6dp; }
    </style>
</head>
<!-- Script UI (docs/scripting.md § Script UI): values from scripts/view/notices.lua (ui.set), buttons send a
     script command (rules "commands") or a ui event back to the view script. -->
<body>
<div class="root" data-model="script">
    <div id="war" class="panel">
        <div class="title">War report</div>
        <div class="row"><span>Trained</span><span>{{trained}}</span></div>
        <div class="row"><span>Lost</span><span>{{lost}}</span></div>
        <div class="row"><span>War chest in</span><span>{{chest}} s</span></div>
        <button data-event-click="send('rally_cry')">Rally cry (Y)</button>
        <button class="small" data-event-click="event('hide')">Hide</button>
    </div>
</div>
</body>
</rml>
