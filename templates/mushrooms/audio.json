// Sound for "Mushroom Clash" — procedural, soft and toy-like. Mass fights produce hundreds of
// pops, so instance limits and cooldowns keep them a texture instead of noise.
{
  "volume": { "sfx": 0.8, "ui": 0.7, "voice": 1.0 },

  // a small toy world: short distances, a soft room, no delay
  "spatial": {
    "minDistance": 8, "maxDistance": 45, "airAbsorption": 3500,
    "reverb": { "size": 0.35, "damping": 0.6, "wet": 0.25, "near": 0.03, "far": 0.35 }
  },

  // Build-time compression per platform (sound files only; the synth sounds here have none).
  // Hundreds of mushrooms meet at once: pops and spore hits share one budget.
  "groups": {
    "pops": { "max": 8, "cooldown": 0.015 }
  },

  "build": {
    "desktop": { "sounds": "keep", "music": "vorbis", "musicQuality": 0.5 },
    "mobile":  { "sounds": "adpcm", "music": "vorbis", "musicQuality": 0.3, "maxRate": 32000 }
  },

  "sounds": {
    "pop":      { "group": "pops", "synth": { "wave": "sine", "freq": [950, 280], "duration": 0.07, "release": 0.05, "volume": 0.4 },
                  "pitch": [0.8, 1.3], "maxInstances": 5, "cooldown": 0.03 },
    "spores":   { "synth": { "wave": "noise", "freq": [3000, 800], "duration": 0.14, "attack": 0.03, "lowpass": 1800, "volume": 0.35 },
                  "pitch": [0.9, 1.1], "maxInstances": 3, "cooldown": 0.1 },
    "sporeHit": { "group": "pops", "synth": { "wave": "sine", "freq": [600, 400], "duration": 0.05, "volume": 0.25 },
                  "pitch": [0.9, 1.2], "maxInstances": 3, "cooldown": 0.05 },
    "captured": { "synth": [ { "wave": "triangle", "freq": 587, "duration": 0.1, "volume": 0.45 },
                             { "wave": "triangle", "freq": 880, "duration": 0.22, "delay": 0.09, "release": 0.18, "volume": 0.45 } ],
                  "bus": "voice", "cooldown": 0.3 },
    "lost":     { "synth": [ { "wave": "triangle", "freq": 440, "duration": 0.12, "volume": 0.45 },
                             { "wave": "triangle", "freq": [330, 300], "duration": 0.3, "delay": 0.11, "release": 0.25, "volume": 0.45 } ],
                  "bus": "voice", "cooldown": 0.3, "priority": 5 },
    "neutral":  { "synth": { "wave": "sine", "freq": [400, 520], "duration": 0.12, "volume": 0.25 }, "cooldown": 0.2 },
    "send":     { "synth": { "wave": "noise", "freq": [1500, 4500], "duration": 0.16, "attack": 0.05, "lowpass": 2500, "volume": 0.3 },
                  "bus": "ui", "cooldown": 0.1 },
    "select":   { "synth": { "wave": "sine", "freq": [520, 700], "duration": 0.06, "volume": 0.35 }, "bus": "ui", "cooldown": 0.06 },
    "victory":  { "synth": [ { "wave": "triangle", "freq": 659, "duration": 0.15, "volume": 0.5 },
                             { "wave": "triangle", "freq": 784, "duration": 0.15, "delay": 0.14, "volume": 0.5 },
                             { "wave": "triangle", "freq": 1047, "duration": 0.7, "delay": 0.28, "release": 0.55, "volume": 0.55 } ],
                  "bus": "voice", "priority": 20 },
    "defeat":   { "synth": [ { "wave": "triangle", "freq": 392, "duration": 0.25, "volume": 0.5 },
                             { "wave": "triangle", "freq": [294, 262], "duration": 0.9, "delay": 0.24, "release": 0.7, "volume": 0.5 } ],
                  "bus": "voice", "priority": 20 }
  },

  "events": {
    "died": "pop",
    "captured": "neutral",
    "select": "select",
    "move": "send",
    "attackOrder": "send",
    "victory": "victory",
    "defeat": "defeat",
    "click": "select"
  },

  "weapons": {
    "spores": { "attack": "spores", "hit": "sporeHit" }
  },

  "types": {
    "village":    { "captured": "captured", "lost": "lost" },
    "bigvillage": { "captured": "captured", "lost": "lost" },
    "tower":      { "captured": "captured", "lost": "lost" },
    "forge":      { "captured": "captured", "lost": "lost" }
  }
}
