# Generates a C++ header with the engine's standard Lua library (modules/rts/lua/*.lua) as byte arrays,
# so the simulation loads it without file access on every platform (headless, server, web, mobile).
#   cmake -DOUT=<header> -DSRC=<dir> -P embed.cmake
file(GLOB files "${SRC}/*.lua")
list(SORT files)
set(body "// Generated by modules/rts/lua/embed.cmake from modules/rts/lua/*.lua - do not edit.\n#pragma once\n#include <cstddef>\nnamespace rts::game::stdlua {\nstruct File { const char* name; const unsigned char* data; size_t size; };\n")
set(table "")
set(i 0)
foreach(f ${files})
    get_filename_component(name "${f}" NAME_WE)
    file(READ "${f}" hex HEX)
    string(LENGTH "${hex}" len)
    math(EXPR size "${len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND body "inline const unsigned char k${i}[] = {${bytes}0};\n")
    string(APPEND table "    {\"${name}\", k${i}, ${size}},\n")
    math(EXPR i "${i} + 1")
endforeach()
string(APPEND body "inline const File kFiles[] = {\n${table}    {nullptr, nullptr, 0}};\n}\n")
file(WRITE "${OUT}.tmp" "${body}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
