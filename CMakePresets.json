{
  "version": 6,
  "configurePresets": [
    { "name": "base", "hidden": true, "binaryDir": "${sourceDir}/build/${presetName}", "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" } },

    { "name": "linux-debug",   "inherits": "base", "generator": "Ninja", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "linux-release", "inherits": "base", "generator": "Ninja", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },

    { "name": "windows-msvc", "inherits": "base", "generator": "Visual Studio 17 2022", "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" } },

    { "name": "macos", "inherits": "base", "generator": "Xcode",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64", "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" } },

    { "name": "ios", "inherits": "base", "generator": "Xcode",
      "cacheVariables": { "CMAKE_SYSTEM_NAME": "iOS", "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0", "RTS_BUILD_TESTS": "OFF", "RTS_BUILD_HEADLESS": "OFF" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" } },

    { "name": "android-arm64", "inherits": "base", "generator": "Ninja",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": { "ANDROID_ABI": "arm64-v8a", "ANDROID_PLATFORM": "android-26", "CMAKE_BUILD_TYPE": "Release", "RTS_BUILD_TESTS": "OFF" } },

    { "name": "web", "inherits": "base", "generator": "Ninja",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } }
  ],
  "buildPresets": [
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" }
  ],
  "testPresets": [
    { "name": "linux-debug", "configurePreset": "linux-debug", "output": { "outputOnFailure": true } }
  ]
}
