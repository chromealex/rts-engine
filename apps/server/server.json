// rts_server configuration. Every key is optional.
{
  "name": "RTSEngine server",
  "udpPort": 27015,              // native clients (iOS, Android, desktop)
  "wsPort": 27016,               // web clients; put a TLS proxy in front for wss:// on HTTPS pages
  "replays": "replays",          // every finished match is saved here (rts_headless --replay plays it)
  "ratings": "ratings.txt",
  "reconnectGraceSec": 120,      // a dropped player who does not come back in time surrenders
  // "surrenderCommand": 22,       // set automatically to the RTS module's kCmdSurrender
  // Game id (game.json "id") -> folder: saved replays reference real files, and the server can
  // decide a match nobody settled (everyone left, results disagree) by re-simulating it.
  "games": {
    "com.rtsengine.ironandgold": "games/skirmish",
    "com.rtsengine.mushroomclash": "games/mushrooms"
  },
  // Defaults for every queue (each queue may override them).
  "defaults": { "tickRate": 20, "inputDelay": 2, "rollbackWindow": 8, "lagToleranceMs": 300 },
  // Automatic matchmaking. A queue matches players who have a map with exactly `teams` teams of
  // `teamSize` slots and the same data hash. botFillSec > 0 fills missing players with bots.
  // "title" is shown to players: "@key" from the lang tables (each client translates it) or plain text.
  "queues": [
    { "id": "1v1", "title": "@net.queue.1v1", "teams": 2, "teamSize": 1, "ratingRange": 150, "ratingWidenPerSec": 10 },
    { "id": "1v1-bots", "title": "@net.queue.1v1_bots", "teams": 2, "teamSize": 1, "botFillSec": 30 },
    { "id": "2v2", "title": "@net.queue.2v2", "teams": 2, "teamSize": 2, "botFillSec": 90 },
    { "id": "ffa4", "title": "@net.queue.ffa4", "teams": 4, "teamSize": 1, "botFillSec": 90 },
    { "id": "1v1-weak", "title": "@net.queue.1v1_low_end", "teams": 2, "teamSize": 1, "rollbackWindow": 0, "inputDelay": 4 }
  ]
}
