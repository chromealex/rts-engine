// "Crystal Dunes": a Red Alert / Dune II style sample — top-down orthographic camera, tile map
// with autotiled transitions (tilesets/desert.json), sprite-sheet units and buildings.
// All art is procedural placeholder art from tools/art2d/make_samples.py (CC0).
{
  "name": "Crystal Dunes",
  "id": "com.rtsengine.crystaldunes",
  "version": "0.1.0",
  "build": 1,
  "module": "rts",
  "rules": "rules.json",
  "maps": [
    { "file": "maps/dunes.json", "title": "Crystal Dunes (1v1)" }
  ],
  "camera": { "projection": "ortho", "pitch": 90, "yaw": 0, "zoomMin": 8, "zoomMax": 40, "rotate": false },
  "orientation": "landscape"
}
