// underlord — en. Keys: modules/rts/RtsLocalize.h; how-to keys: engine/ui docs.
{
  "@language": "English",

  // how to play (UI: "How to play" screen)
  "howto.like": "Dungeon Keeper: dig a dungeon, build rooms, grab creatures with the hand and possess them.",
  "howto.goal": "Destroy the enemy Dungeon Heart and keep yours.",
  "howto.tip": "First dig to a gold vein and build a lair and a hatchery — creatures will not come without them.",
  "howto.step1": "Press Dig on the bottom bar and drag over rock: imps tunnel through. Gold veins fill the treasury.",
  "howto.step2": "Rooms are buttons next to it, dragged over your own floor: a lair houses creatures, a hatchery breeds chickens (food), a library makes research, a training room gives experience.",
  "howto.step3": "A portal in your territory attracts goblins, warlocks and trolls if there is a lair and food for them.",
  "howto.step4": "Hand: To hand on the card picks up the selection, Drop on the bottom bar drops them where you click (Shift: all at once). Slap speeds up idlers but hurts.",
  "howto.step5": "Possess to control a creature yourself: WASD or the right button walks, the left button attacks; Esc or Leave body returns. Possession and every second in the body cost mana."
}
