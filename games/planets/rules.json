// "Planets" — Metal Tide on a planet and its moon (docs/planets.md): the same TA-like flow economy, plus an
// orbital yard whose gunships fly on the orbit shell, strike the surface below and transfer between bodies.
// Rules derived from games/metaltide.
// "Metal Tide" — Total Annihilation-like: metal and energy are flows (income per second, storage caps),
// everything is paid while it is being built (progressive cost, stalls when a flow runs dry), extractors
// sit on metal spots, rocks and wrecks are reclaimed for metal, the commander is the key unit.
{
  "victory": "keyUnits",
  "costModel": "progressive",
  "supplyCap": 200,
  // Heightfield terrain: the map's corner heights drive slopes, line of sight and height bonuses. The central
  // ridge is too steep for heavy kbots and the commander (0.8) but light kbots climb it (move.maxSlope 1.6).
  "terrain": {"model": "heightfield", "maxSlope": {"ground": 0.8}, "uphillSpeed": 0.5, "downhillSpeed": 0.2},
  "heights": {"rangePerLevel": 0.75, "damagePerLevel": 0.1, "missUphill": 0.15},
  "resources": {
    "metal": {"name": "Металл", "kind": "flow", "start": 600, "storage": 1000, "deficitProduction": 0.3},
    "energy": {"name": "Энергия", "kind": "flow", "start": 1000, "storage": 1500, "deficitProduction": 0.3}
  },
  "types": {
    "commander": {"name": "Командир", "key": true, "health": {"max": 3000, "armor": 3, "regen": 2}, "move": {"speed": 1.8, "radius": 0.6}, "sight": 10,
                  "weapons": [{"range": 4, "damage": 25, "cooldown": 1, "projectileSpeed": 16}], "income": {"metal": 1, "energy": 20},
                  "builds": ["extractor", "solar", "kbot_lab", "defender", "orbital_yard"], "buildPower": 3,
                  "gather": {"metal": {"carry": 20, "time": 2}}, "view": {"shape": "mech", "scale": 1.4}},
    "constructor": {"name": "Строитель", "health": {"max": 300}, "move": {"speed": 2.2, "radius": 0.45, "maxSlope": 1.6}, "sight": 8,
                    "cost": {"metal": 110, "energy": 900, "time": 15}, "builds": ["extractor", "solar", "kbot_lab", "defender", "orbital_yard"], "buildPower": 1.5,
                    "gather": {"metal": {"carry": 10, "time": 2}}, "view": {"shape": "worker"}},
    "peewee": {"name": "Пиви", "health": {"max": 250}, "move": {"speed": 3, "radius": 0.4, "maxSlope": 1.6}, "sight": 8,
               "weapons": [{"range": 4, "damage": 10, "cooldown": 0.6}], "cost": {"metal": 50, "energy": 600, "time": 8}, "wreck": {"metal": 25}, "view": {"shape": "soldier"}},
    "hammer": {"name": "Молот", "health": {"max": 550, "armor": 1}, "move": {"speed": 2.2, "radius": 0.5}, "sight": 9,
               "weapons": [{"range": 6, "damage": 35, "cooldown": 1.8, "projectileSpeed": 12, "splash": 0.8}], "cost": {"metal": 120, "energy": 1300, "time": 14}, "wreck": {"metal": 60}, "view": {"shape": "mech"}},
    "extractor": {"name": "Экстрактор", "structure": {"footprint": [2, 2], "on": "metal_spot"}, "health": {"max": 300}, "cost": {"metal": 50, "energy": 500, "time": 8},
                  "income": {"metal": 3, "energy": -3}, "view": {"shape": "refinery"}},
    "solar": {"name": "Солнечный коллектор", "structure": {"footprint": [2, 2]}, "health": {"max": 300}, "cost": {"metal": 140, "energy": 0, "time": 10},
              "income": {"energy": 20}, "storage": {"energy": 100}, "view": {"shape": "plant"}},
    "kbot_lab": {"name": "Лаборатория роботов", "structure": {"footprint": [4, 4]}, "health": {"max": 1500, "armor": 2}, "cost": {"metal": 500, "energy": 1000, "time": 30},
                 "produces": ["constructor", "peewee", "hammer"], "buildPower": 1, "storage": {"metal": 200}, "view": {"shape": "workshop"}},
    "defender": {"name": "Страж", "structure": {"footprint": [2, 2]}, "health": {"max": 1000, "armor": 3}, "sight": 10, "cost": {"metal": 120, "energy": 900, "time": 12},
                 "weapons": [{"range": 7, "damage": 22, "cooldown": 1, "projectileSpeed": 18, "targets": ["ground", "air", "orbit"]}], "requires": ["kbot_lab"], "view": {"shape": "tower"}},
    "orbital_yard": {"name": "Орбитальная верфь", "structure": {"footprint": [3, 3]}, "health": {"max": 1200, "armor": 2}, "cost": {"metal": 400, "energy": 1500, "time": 25},
                     "produces": ["gunship"], "buildPower": 1, "requires": ["kbot_lab"], "view": {"shape": "workshop"}},
    "gunship": {"name": "Канонерка", "health": {"max": 400, "armor": 1}, "move": {"speed": 3, "radius": 0.5, "layer": "orbit", "transitSpeed": 40}, "sight": 10,
                "weapons": [{"range": 7, "damage": 18, "cooldown": 1, "projectileSpeed": 20, "targets": ["ground", "orbit"]}],
                "cost": {"metal": 160, "energy": 1600, "time": 16}, "wreck": {"metal": 40}, "view": {"shape": "mech"}},
    "metal_spot": {"name": "Залежь металла", "structure": {"footprint": [2, 2]}, "invulnerable": true, "view": {"shape": "spot"}},
    "wreck_rock": {"name": "Валун", "structure": {"footprint": [1, 1]}, "invulnerable": true, "resourceNode": {"resource": "metal", "amount": 150}, "view": {"shape": "rock"}},
    "wreck": {"name": "Обломки", "invulnerable": true, "resourceNode": {"resource": "metal", "amount": 50}, "view": {"shape": "wreck"}}
  }
}
