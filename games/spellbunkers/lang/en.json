  "@language": "English",

  // how to play (UI: "How to play" screen)
  "howto.like": "Bunker Wars on Mushroom Wars 2 lanes: garrisons grow by themselves, the spell deck decides the game.",
  "howto.goal": "Capture every enemy building.",
  "howto.tip": "Freeze a big enemy squad on a lane and meet it with your own — it never arrives.",
  "howto.step1": "The hive, huts and towers grow spores. Drag from your building to a target: the squad marches along a lane.",
