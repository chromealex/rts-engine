      "produces": ["footman", "archer"],
      "view": { "shape": "barracks", "light": { "color": [1.0, 0.6, 0.28], "radius": 4, "intensity": 1.3, "height": 1.0, "flicker": 0.18 } }
    },
    "workshop": {
      "name": "Workshop",
      "structure": { "footprint": [3, 3] },
      "health": { "max": 900, "armor": 3, "armorType": "fortified" },
      "cost": { "gold": 150, "wood": 100, "time": 40 },
      "requires": ["barracks"],
      "produces": ["catapult", "gryphon"],
      "view": { "shape": "workshop", "light": { "color": [1.0, 0.45, 0.15], "radius": 4.5, "intensity": 2.0, "height": 0.7, "flicker": 0.3 } }
    },
    "tower": {
      "name": "Guard Tower",
      "structure": { "footprint": [2, 2] },
      "health": { "max": 500, "armor": 4, "armorType": "fortified" },
      "sight": 11,
      "weapons": [ { "id": "arrows", "range": 7, "damage": 18, "cooldown": 1.2, "projectileSpeed": 16,
                     "targets": ["ground", "air"], "damageType": "pierce" } ],
      "cost": { "gold": 110, "wood": 80, "time": 30 },
      "view": { "shape": "tower", "light": { "color": [1.0, 0.6, 0.28], "radius": 4.5, "intensity": 1.5, "height": 2.4, "flicker": 0.18 } }
