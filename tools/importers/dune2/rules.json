      "view": {"shape": "hall"}},
    "windtrap": {"name": "Windtrap", "tags": ["building"], "structure": {"footprint": [2, 2], "terrain": "rock", "extendsBase": true},
      "health": {"max": 400, "armorType": "building"}, "cost": {"spice": 300, "time": 30}, "provides": {"power": 100}, "requires": ["const_yard"],
      "view": {"shape": "tower"}},
    "refinery": {"name": "Spice Refinery", "tags": ["building"], "structure": {"footprint": [3, 2], "terrain": "rock", "extendsBase": true},
      "health": {"max": 900, "armorType": "building"}, "cost": {"spice": 400, "time": 40}, "consumes": {"power": 30}, "requires": ["windtrap"],
      "dropoff": ["spice"], "storage": {"spice": 1000}, "view": {"shape": "factory"}},
