// Dune II rules for RTSEngine, written for the importer (tools/importers/dune2).
// Numbers approximate the original game's balance from public descriptions; they are our own data,
// not extracted from DUNE2.EXE. Speeds are map cells per second, times are game seconds.
// `view.sprite` points at the sprite sheets the importer converts from the user's copy
// (docs/asset-format.md); until the renderer draws sprites, `view.shape` is used.
// Unit limit: every unit takes 1 supply and a Construction Yard gives 25 (Dune II MaxUnit).
{
  "supplyCap": 200,
  "maxQueue": 5,
  "sellRefund": 0.5,
  "buildRadius": 2,
  "victory": "noStructures",
  "armorTypes": ["infantry", "light", "heavy", "building"],
  "damageTable": {
    "bullet":  {"infantry": 1.0,  "light": 0.75, "heavy": 0.3,  "building": 0.3},
    "cannon":  {"infantry": 0.5,  "light": 1.0,  "heavy": 1.0,  "building": 0.75},
    "rocket":  {"infantry": 0.35, "light": 1.0,  "heavy": 1.25, "building": 1.0},
    "sonic":   {"infantry": 1.25, "light": 1.0,  "heavy": 0.75, "building": 0.5},
    "worm":    {"infantry": 1.0,  "light": 1.0,  "heavy": 1.0,  "building": 0.0}
  },
  "resources": {
    "spice": {"name": "Spice", "field": true, "regrow": 0, "cellMax": 100, "capped": true, "start": 0},
    "power": {"name": "Power", "kind": "capacity", "deficitProduction": 0.5, "deficitDisables": ["defense"]}
  },
  "types": {
    // ------------------------------------------------------------ structures
