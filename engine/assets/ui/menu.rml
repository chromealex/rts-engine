<rml>
<head>
    <title>menu</title>
    <link type="text/rcss" href="theme.rcss"/>
</head>
<!-- Texts "@key" come from engine/assets/lang/<language>.json (a game overrides them in lang/). -->
<body>
<!-- the model is bound on a div: <body> is the document element itself and binds too late -->
<div class="root" data-model="game" data-class-touch="touch">
    <div id="menu" class="panel" data-if="screen == 'menu'">
        <h1>{{gameName}}</h1>
        <p class="error" data-if="error != ''">{{error}}</p>

        <h2>@menu.difficulty</h2>
        <div class="choice">
            <button data-class-active="difficulty == 0" data-event-click="difficulty = 0">@menu.easy</button>
            <button data-class-active="difficulty == 1" data-event-click="difficulty = 1">@menu.normal</button>
            <button data-class-active="difficulty == 2" data-event-click="difficulty = 2">@menu.hard</button>
        </div>
        <button class="small" data-class-active="spectator" data-event-click="spectator = !spectator">@menu.spectate</button>

        <h2>@menu.map</h2>
        <button class="map" data-for="m, i : maps" data-event-click="start(i)">{{m}}</button>

        <button class="map online" data-event-click="net('open')">@ui.online</button>

        <div data-if="languages.size > 0">
            <h2>@menu.language</h2>
            <div class="choice">
                <button class="small" data-for="l : languages" data-class-active="l.active" data-event-click="act(l.id)">{{l.label}}</button>
            </div>
        </div>

        <p class="dim footer">{{platformInfo}}</p>
    </div>
</div>
</body>
</rml>
