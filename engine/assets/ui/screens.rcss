/* Building blocks for a game's own screens (ui/screens/*.rml, docs/ui-scripting.md). Linked by every
   screen after theme.rcss and before the game's skin.rcss, so a skin restyles them like the rest.

   Layout:  .screen > .screen-header (.screen-title, button.back) + .screen-body (scrolls) + .screen-footer
   Pieces:  .currencies .currency, .tabs button(.active), .cards .card (.card-title .card-text .card-price),
            .list .list-row, .stat (.stat-value .stat-label), .progress-bar > .progress-fill, .badge,
            button.primary / .secondary / .big, .popup-bg > .popup, .center, .grow, .row, .muted, .avatar */

.screen {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    display: flex; flex-direction: column;
    pointer-events: auto;
    decorator: vertical-gradient(#1b2330ff #0c1016ff);
}
.screen-header {
    display: flex; align-items: center;
    padding: 10dp 14dp; min-height: 44dp;
    background-color: #00000040;
}
.screen-title { flex: 1; font-family: title; font-size: 22dp; font-weight: bold; color: #f2d48a; }
.screen-header button.back { margin-right: 10dp; padding: 6dp 12dp; }
.screen-body { flex: 1; overflow-y: auto; padding: 12dp 14dp; }
.screen-footer { display: flex; justify-content: center; padding: 10dp 14dp; background-color: #00000040; }
.center { text-align: center; }
.row { display: flex; align-items: center; }
.grow { flex: 1; }
.muted { color: #8d98a6; font-size: 13dp; }
.spacer { height: 12dp; }

/* currencies in the header: <span class="currency">{{profile.gold}} <span class="muted">@currency.gold</span></span> */
.currencies { display: flex; }
.currency {
    display: block; margin-left: 8dp; padding: 3dp 10dp;
    border-radius: 12dp; background-color: #00000060; color: #ffe6a6; font-weight: bold;
}

button.primary { decorator: vertical-gradient(#e8c26aff #c79a3cff); color: #1a1f26; border-color: #ffe6a6; font-weight: bold; }
button.primary:hover { decorator: vertical-gradient(#f2d48aff #d6aa4cff); }
button.secondary { decorator: none; background-color: #ffffff12; }
button.big { display: block; padding: 12dp 18dp; margin: 6dp 0; font-size: 18dp; text-align: center; }
button.icon { padding: 4dp 9dp; }

.tabs { display: flex; margin-bottom: 10dp; }
.tabs button { flex: 1; margin: 0 2dp; text-align: center; }

.cards { display: flex; flex-wrap: wrap; }
.card {
    display: block; width: 150dp; margin: 0 10dp 10dp 0; padding: 10dp;
    border-radius: 8dp; border: 1dp #ffffff1c; background-color: #ffffff0d;
}
.card.owned { border-color: #8fe08f80; }
.card-icon { display: block; width: 64dp; height: 64dp; margin: 0 auto 6dp auto; }
.card-title { display: block; font-weight: bold; margin-bottom: 3dp; }
.card-text { display: block; color: #9aa6b5; font-size: 12dp; min-height: 30dp; }
.card button { display: block; margin: 8dp 0 0 0; text-align: center; }

.list { display: block; }
.list-row {
    display: flex; align-items: center;
    padding: 8dp 10dp; margin: 4dp 0; border-radius: 6dp; background-color: #ffffff0a;
}
.list-row.locked { opacity: 0.5; }

.stats { display: flex; flex-wrap: wrap; }
.stat { display: block; width: 110dp; margin: 0 10dp 10dp 0; padding: 8dp; border-radius: 6dp; background-color: #ffffff0a; text-align: center; }
.stat-value { display: block; font-size: 22dp; font-weight: bold; color: #f2d48a; }
.stat-label { display: block; font-size: 12dp; color: #8d98a6; }

.progress-bar { display: block; height: 8dp; border-radius: 4dp; background-color: #00000080; }
.progress-fill { display: block; height: 8dp; border-radius: 4dp; background-color: #e8c26a; }

.badge { display: inline-block; padding: 1dp 7dp; border-radius: 9dp; background-color: #e8c26a; color: #1a1f26; font-size: 11dp; font-weight: bold; }
.avatar {
    display: block; width: 72dp; height: 72dp; margin-right: 14dp; border-radius: 36dp;
    background-color: #e8c26a; color: #1a1f26; font-size: 32dp; font-weight: bold; text-align: center; line-height: 72dp;
}
input.text.name { width: 220dp; }

/* popups (ui.popup): the dimmed background takes the pointer */
.popup-bg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #000000a0; pointer-events: auto; }
.popup {
    position: absolute; top: 22%; left: 0; right: 0; width: 360dp; max-width: 92%; margin: 0 auto;
    padding: 18dp 20dp; text-align: center;
}
.popup .buttons { display: flex; justify-content: center; margin-top: 14dp; }
.popup .buttons button { margin: 0 6dp; min-width: 100dp; text-align: center; }

.touch .screen-header { min-height: 52dp; }
.touch button.big { padding: 15dp 18dp; }

@media (orientation: portrait) {
    .card { width: 44%; margin-right: 3%; }
    .screen-header { padding: 8dp 10dp; }
    .screen-title { font-size: 18dp; }
    .screen-header button.back { margin-right: 8dp; padding: 5dp 9dp; }
    .currency { margin-left: 5dp; padding: 2dp 8dp; font-size: 13dp; }
    .currency .muted { display: none; }   /* numbers only on narrow screens: skins can add an icon */
}
